# Copy to api/.env and change the values. Never commit .env.
# Validated at startup by src/config/env.ts.

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Matches the credentials in the root .env used by docker-compose.yml
MONGODB_URI=mongodb://receipt2books:change-me@localhost:27017/receipt2books?authSource=admin

# Use a long random string, e.g. the output of: openssl rand -hex 32
JWT_SECRET=replace-me
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:8081

# Needed from S1-T15 (Claude: field extraction from receipt photos)
ANTHROPIC_API_KEY=

# Needed from S1-T16 (Jev by TypeSafe: category choice). Key from https://console.typesafe.ai/keys
TYPESAFE_API_KEY=

# Which classifier picks the category:
#   jev    = Jev first, Claude's suggestion as backup if Jev fails or times out (default)
#   claude = skip Jev, use Claude's suggestion (use this if Jev is down or misbehaving)
#   none   = no AI category; receipts are saved as "Uncategorized" for the user to pick
CATEGORY_CLASSIFIER=jev
JEV_TIMEOUT_MS=3000

# Review thresholds for Jev's category confidence (starting values, tune after testing)
CATEGORY_FLAG_BELOW=0.5
CATEGORY_SUGGESTED_BELOW=0.9
