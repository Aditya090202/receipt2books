{
  // Production build: compiles src/ only (no tests) into dist/.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    // No Jest globals in production code.
    "types": ["node"],
    "outDir": "dist",
    "noEmit": false,
    "sourceMap": true
  },
  "include": ["src"]
}
